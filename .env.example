# AI Gateway Pool Open — variables d'environnement (AUCUN secret dans ce fichier d'exemple).
# Les variables POOL_* disent QUEL fichier charger et pour QUEL environnement ; le YAML décrit les
# nœuds et les politiques (config/*.yaml). Les deux doivent s'accorder sur l'environnement.

# Environnement attendu : development | staging | production (aucun défaut, jamais production implicite).
POOL_ENVIRONMENT=production
# Fichier YAML du Pool (copie relue de config/compact.example.yaml pour un déploiement).
POOL_CONFIG_FILE=/etc/ai-gateway-pool/pool.yaml
# 1 en déploiement : un fichier `status: example` est refusé au démarrage.
POOL_REQUIRE_APPROVED_CONFIG=0
# Jeton des routes /internal/* (vide = routes désactivées, 404). À GÉNÉRER localement :
#   openssl rand -hex 32   — jamais versionné, jamais publié, jamais relayé à une Gateway.
POOL_ADMIN_TOKEN=
POOL_LOG_LEVEL=INFO
# Écoute : 127.0.0.1 hors conteneur ; 0.0.0.0 dans un conteneur (réseau Compose interne).
POOL_BIND_HOST=127.0.0.1
POOL_BIND_PORT=8080
# URL Redis de l'affinité de jobs — SEULEMENT si job_affinity.backend=redis ; le YAML ne porte que
# le NOM de cette variable (redis_url_env). Exemple : redis://:<mot de passe>@redis:6379/0
AIGP_REDIS_URL=
