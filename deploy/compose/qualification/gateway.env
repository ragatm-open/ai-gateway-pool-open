# AI Gateway Open — configuration du nœud de QUALIFICATION (identique au profil Compact CPU
# lors de la qualification, recopiée ici pour ne pas référencer la configuration nominale Compact). Aucun secret.
AI_GATEWAY_PORT=8100
AI_GATEWAY_TIMEOUT_SECONDS=300
AI_GATEWAY_LOG_LEVEL=INFO
AI_GATEWAY_ENVIRONMENT=production
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATE_MODEL=compact-generation-8
OLLAMA_EMBEDDING_MODEL=fr-en-retrieval
AI_GATEWAY_EMBEDDINGS_DIMENSION=768
AI_GATEWAY_EMBEDDINGS_MAX_BATCH=64
AI_GATEWAY_GENERATION_STRICT_REGISTRY=1
AI_GATEWAY_EMBEDDINGS_STRICT_REGISTRY=1
AI_GATEWAY_GENERATE_MAX_CONCURRENCY=2
AI_GATEWAY_EMBEDDINGS_MAX_CONCURRENCY=2
AI_GATEWAY_REQUEST_MAX_BYTES=2097152
AI_GATEWAY_RERANK_ENABLED=1
AI_GATEWAY_RERANK_BACKEND_URL=http://127.0.0.1:8300
AI_GATEWAY_RERANK_MODEL=rerank-default
AI_GATEWAY_RERANK_TIMEOUT_SECONDS=30
AI_GATEWAY_RERANK_MAX_CONCURRENCY=2
AI_GATEWAY_RERANK_BACKEND_IMAGE_DIGEST=sha256:8de25e75ce39617f17f2f6c77d60a4f75b65e779ed5005420eb1400072a15c1c
AI_GATEWAY_ASR_ENABLED=0
AI_GATEWAY_VISION_ENABLED=0
AI_GATEWAY_READINESS_CACHE_SECONDS=60
AI_GATEWAY_READINESS_TIMEOUT_SECONDS=30
AI_GATEWAY_REGISTRY_VERIFY_INTERVAL_SECONDS=300
