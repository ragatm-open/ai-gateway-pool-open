# AI Gateway Pool Open — `.env` du déploiement Compose (copier en `.env`, mode 0600). Aucun secret
# ci-dessous : générer POOL_ADMIN_TOKEN et REDIS_PASSWORD localement (openssl rand -hex 32).
COMPOSE_PROJECT_NAME=aigp-open
POOL_IMAGE_TAG=local
POOL_ENVIRONMENT=production
POOL_REQUIRE_APPROVED_CONFIG=1
POOL_LOG_LEVEL=INFO
POOL_PORT=18090
POOL_MEM=512m
POOL_ADMIN_TOKEN=
REDIS_PASSWORD=
# Réseau Docker externe où le service `ai-gateway` est joignable (ex. `ragatm-compact_ai`).
UPSTREAM_NETWORK=
